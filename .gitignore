# ═══════════════════════════════════════════════════════════════════
# Pharma LMS — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Environment & Secrets ──
.env
.env.*
!.env.example
**/.env
**/.env.*
config/passwords.yaml
config/firebase_service_account_key.json
*.pem
*.key

# ── Local Config ──
pharma_lms/pharma_lms_flutter/assets/config.local.json

# ── IDE & OS ──
.DS_Store
**/.DS_Store
.idea/
**/.idea/
*.iml
.vscode/
**/.vscode/
*.swp
*.swo
.cursor/
.cursorignore

# ── Dart / Flutter ──
.dart_tool/
**/.dart_tool/
.packages
**/.packages
.pub-cache/
**/.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins
**/.flutter-plugins-dependencies
.metadata
**/.metadata
**/build/

# ── Android ──
**/.gradle/
**/local.properties
**/key.properties
**/*.jks

# ── iOS / macOS ──
**/Pods/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/DerivedData/

# ── Python (QA tools) ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
*.egg-info/
.eggs/
dist/
*.egg

# ── Logs ──
*.log

# ── Deployment ──
.vercel
ngrok.log
/tmp/ngrok*

# ── Never commit: design reference artifacts ──
stitch/
stitch*/
ref/
people*/
.claude/
