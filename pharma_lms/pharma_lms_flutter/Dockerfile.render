# Build Flutter Web
FROM ghcr.io/cirruslabs/flutter:3.24.0 AS build

WORKDIR /app

# Copy Flutter app
COPY pharma_lms_flutter ./pharma_lms_flutter

# Set production API URL
RUN echo '{"apiUrl": "https://pharma-lms-api.onrender.com/"}' > pharma_lms_flutter/assets/config.json

# Build web
WORKDIR /app/pharma_lms_flutter
RUN flutter pub get
RUN flutter build web --release --web-renderer html

# Serve with nginx — CDN-ready with gzip, security headers, and aggressive caching
FROM nginx:alpine

# Copy built web files
COPY --from=build /app/pharma_lms_flutter/build/web /usr/share/nginx/html

# Production nginx config with CDN headers, gzip compression, and security hardening
RUN cat > /etc/nginx/conf.d/default.conf << 'NGINX'
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # ── Gzip compression for all text-based assets ──
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/wasm
        image/svg+xml font/woff2;

    # ── Security headers ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ── SPA fallback ──
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Hash-busted assets: cache for 1 year, immutable ──
    location ~* \.(js|css|wasm|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # ── CanvasKit / Flutter engine — long cache ──
    location /canvaskit/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # ── Service-worker & manifest — short cache so updates propagate ──
    location = /flutter_service_worker.js {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }
    location = /manifest.json {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    # ── index.html — never cache so new deployments are picked up immediately ──
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # ── Health check endpoint for load balancers / Render ──
    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
NGINX

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
